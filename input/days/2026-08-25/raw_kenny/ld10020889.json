   "content": {
    "title": "Fire in U.S. state of Nevada destroys a dozen homes",
    "lead": "Fire department reported progress in fighting a wildfire on the outskirts of Reno, but some residents lost their homes",
    "author": ""
   },
   "containers": {
    "authors": []
   },

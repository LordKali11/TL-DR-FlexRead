     "mimeType": "image/png",
     "imageService": "fastly",
     "url": "https://img-msp-prod.nzz.ch/2026/09/01/e9d7ed41-aa04-4801-8996-23951bf32ae8.png?width=1024&quality=75&auto=webp"
    }
   },
   "paidContent": true,
   "prevElement": "newsletter_baukasten-text",
   "nextElement": "newsletter_baukasten-text"

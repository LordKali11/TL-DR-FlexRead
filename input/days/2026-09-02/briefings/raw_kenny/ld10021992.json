   "content": {
    "link": {
     "href": "https://bellevue.nzz.ch/kochen-geniessen/wein/welche-spanischen-weine-gehoeren-in-jeden-weinkeller-ld.1934598",
     "target": "_blank"
    },
    "image": {
     "originalUrl": "https://nzzprod-endpoint-cue7enfnfqc8ekg7.a03.azurefd.net/images/2026/09/01/18bb808c-4da7-49ac-aa0c-69cff56ec47a.jpg",

  },
  {
   "identifier": "newsletter_baukasten-subtitle",
   "id": "doc-1jjjj46r60",
   "content": {
    "title": "Is it advisable to enjoy wine from clay jugs?"
   },
   "paidContent": true,
   "prevElement": "newsletter_baukasten-footnote",
   "nextElement": "newsletter_baukasten-image"
  },

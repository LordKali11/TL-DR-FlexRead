     "mimeType": "image/jpeg",
     "imageService": "fastly",
     "url": "https://img-msp-prod.nzz.ch/2026/09/01/18bb808c-4da7-49ac-aa0c-69cff56ec47a.jpg?width=1024&quality=75&auto=webp"

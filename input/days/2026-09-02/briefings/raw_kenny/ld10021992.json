   "content": {
    "link": {
     "href": "https://bellevue.nzz.ch/kochen-geniessen/wein/mont-vully-murtensee-geheimtipp-fuer-weinliebhaber-ld.1935117",
     "target": "_blank"
    },
    "image": {
     "originalUrl": "https://nzzprod-endpoint-cue7enfnfqc8ekg7.a03.azurefd.net/images/2026/09/01/1c01c1ea-1e34-40eb-b9cd-52e9b166f24c.png",
     "mediaId": "NTitWOC9vdIw",
     "key": "2026/09/01/1c01c1ea-1e34-40eb-b9cd-52e9b166f24c.png",
     "width": 2700,
     "height": 1800,
     "mimeType": "image/png",
     "imageService": "fastly",
     "url": "https://img-msp-prod.nzz.ch/2026/09/01/1c01c1ea-1e34-40eb-b9cd-52e9b166f24c.png?width=1024&quality=75&auto=webp"
    },
    "source": "Getty Images"
   },
   "paidContent": true,
   "prevElement": "newsletter_baukasten-subtitle",
   "nextElement": "newsletter_baukasten-text"
  },
  {
   "identifier": "newsletter_baukasten-text",
   "id": "doc-1jjjj5a6v0",
   "content": {
    "text": "The Mont Vully wine region on Lake Murten offers many oenological experiences. <a target=\"_blank\" href=\"https://bellevue.nzz.ch/kochen-geniessen/wein/mont-vully-murtensee-geheimtipp-fuer-weinliebhaber-ld.1935117\">You can discover exciting wines, ambitious restaurants, and a historic château that now houses a stylish boutique hotel.</a>"
   },
   "paidContent": true,
   "prevElement": "newsletter_baukasten-image",
   "nextElement": "newsletter_baukasten-infobox"
  },
  {
   "identifier": "newsletter_baukasten-infobox",
   "id": "doc-1k1eqvppv0",
   "content": {
    "emoji": "Ein Angebot vom NZZ Shop",
    "title": "A Rioja that shows its origin",
    "description": "A Rioja with a special origin and an even more special character: The ambitious Bideona winery has created a special bottling exclusively for Peter Keller. The Revillas Bideona 2021 from the Rioja Alavesa impresses with black berries, spicy notes, rounded tannins, fine acidity, and a long, elegant finish.<br> Only 300 bottles of this exclusive edition were produced. <a target=\"_blank\" href=\"https://shop.nzz.ch/Weinpaket-Rioja-Revillas-Bideona-NZZ-Edition-mit-Peter-Keller/SW13996\">Secure your 6-bottle case of this limited NZZ edition now – a special Rioja for lovers of characterful wines.</a><br><br> <strong>Price:</strong> CHF 179.00 / Subscription price: CHF 169.00",
    "image": {
     "originalUrl": "https://nzzprod-endpoint-cue7enfnfqc8ekg7.a03.azurefd.net/images/2026/09/01/e9d7ed41-aa04-4801-8996-23951bf32ae8.png",
     "mediaId": "1CsuRyIqIK8F",
     "key": "2026/09/01/e9d7ed41-aa04-4801-8996-23951bf32ae8.png",
     "width": 900,

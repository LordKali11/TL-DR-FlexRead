  {
   "identifier": "subtitle",
   "id": "doc-1k0pe42qt0",
   "content": {
    "title": "In this podcast episode",
    "id": "subtitle-in-dieser-podcast-episode"
   },
   "contentTable": false,
   "paidContent": true,
   "prevElement": "p-text",
   "nextElement": "sharebox",

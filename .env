# Environment Configuration
ENV=development
DEBUG=True
PORT=8080

# Primary Persistent Database: Remote MongoDB Cloud Instance
MONGODB_URI=mongodb://flexread:-bRp7XKPpJwqsiuRmwY4kBeZwgNgkJcsZsYOTtGGJ4xS_95V@1eccc27e-3c55-45dd-9fce-65fa61affe3e.europe-west3.firestore.goog:443/nzz-flexread-db?loadBalanced=true&tls=true&authMechanism=SCRAM-SHA-256&retryWrites=false
MONGODB_DB_NAME=nzz-flexread-db
MONGODB_TLS_ALLOW_INVALID_CERTS=true
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Cache Layer Toggle & Redis
ENABLE_REDIS=false
CACHE_TYPE=memory
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=604800

# Google Gemini / Vertex AI Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GOOGLE_CLOUD_PROJECT=nzz-flexread-hackathon
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=false

# Reading Speed Default (WPM)
DEFAULT_WPM=220

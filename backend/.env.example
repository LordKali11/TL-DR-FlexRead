# Environment Configuration
ENV=development
DEBUG=True
PORT=8080

# Primary Persistent Database: MongoDB
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=nzz_flexread

# Ultra-Fast Cache Layer: Redis
CACHE_TYPE=redis
REDIS_URL=redis://localhost:6379/0
# Optional host/port/password for GCP Memorystore
# REDIS_HOST=10.0.0.3
# REDIS_PORT=6379
# REDIS_PASSWORD=
CACHE_TTL_SECONDS=604800

# Google Gemini / Vertex AI Settings
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CLOUD_PROJECT=nzz-flexread-hackathon
GOOGLE_CLOUD_LOCATION=europe-west1
GOOGLE_GENAI_USE_VERTEXAI=false

# Reading Speed Default (WPM)
DEFAULT_WPM=220
